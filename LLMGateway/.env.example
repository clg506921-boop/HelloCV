# DeepSeek Harness 网关 · 环境变量模板
#
# 用法：复制成 .env 后填入真实值，再在 shell 里显式载入：
#     cp .env.example .env
#     # 编辑 .env，把下面的 sk-xxx 换成你自己的密钥
#     chmod 600 .env
#     set -a; . ./.env; set +a
#
# 说明：
#   * .env 已被 .gitignore 忽略（见仓库根 .gitignore 第 4 行），不会被提交；
#   * 代码只读环境变量（gateway/config.py 的 resolved_api_key()），
#     不会自动解析 .env 文件，所以必须像上面那样显式载入；
#   * 本文件（.env.example）只放占位符，绝不要写入真实密钥。

# 必填：DeepSeek 官方 API 密钥（在 DeepSeek 开放平台申请）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：上游地址（默认就是官方地址，通常不用改）
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# 可选：模型名（默认 deepseek-flash）
# DEEPSEEK_MODEL=deepseek-flash
